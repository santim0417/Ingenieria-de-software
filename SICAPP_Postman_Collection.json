{
    "info": {
        "_postman_id": "9b8c7d6e-5f4a-3b2c-1d0e-sicapp2026qa",
        "name": "SICAPP_PROTOTIPO - Suite Pruebas de Integracion QA",
        "description": "Coleccion oficial de Pruebas de Integracion HTTP para el prototipo SICAPP (Flask: http://127.0.0.1:5000). Valida los casos TC-SIC2-01 a TC-SIC26-02.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. TC-SIC8-02: Login con formato de correo invalido",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"HTTP Status es 200 (Renderiza alerta en Login)\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "pm.test(\"TC-SIC8-02: Muestra error de formato de correo no valido\", function () {",
                            "    pm.expect(pm.response.text()).to.include(\"Error: Formato de correo electrónico no válido\");",
                            "});",
                            "pm.test(\"RNF-01: Tiempo de respuesta menor a 500ms\", function () {",
                            "    pm.expect(pm.response.responseTime).to.be.below(500);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "urlencoded",
                    "urlencoded": [
                        {
                            "key": "email",
                            "value": "correo_invalido_sin_dominio",
                            "type": "text"
                        },
                        {
                            "key": "password",
                            "value": "Password123",
                            "type": "text"
                        }
                    ]
                },
                "url": {
                    "raw": "http://127.0.0.1:5000/login",
                    "protocol": "http",
                    "host": [
                        "127",
                        "0",
                        "0",
                        "1"
                    ],
                    "port": "5000",
                    "path": [
                        "login"
                    ]
                }
            }
        },
